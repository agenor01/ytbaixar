// Deploy da interface no Cloudflare (Workers com arquivos estáticos).
// Só a interface vai pro ar: os downloads precisam do yt-dlp + ffmpeg, que rodam no app de PC.
// Sem o servidor, o site mostra um aviso com o link do instalador.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ytbaixar",
  "compatibility_date": "2026-10-23",
  // Compila a interface antes de publicar (o Cloudflare não roda "pnpm build" sozinho)
  "build": {
    "command": "pnpm build"
  },
  "assets": {
    // Só a pasta compilada (~20 arquivos); "web" inteira levava junto o node_modules
    "directory": "./web/dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
