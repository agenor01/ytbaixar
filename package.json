{
  "name": "ytbaixar",
  "version": "1.0.0",
  "private": true,
  "description": "Baixe vídeos do YouTube e do YouTube Music em MP4 — site local, PWA e app de PC.",
  "scripts": {
    "postinstall": "pnpm --dir web install",
    "build": "pnpm --dir web build",
    "dev": "pnpm --dir web dev",
    "icons": "pnpm --dir web icons",
    "start": "node server.js",
    "app": "node server.js --app",
    "atalho": "powershell -NoProfile -ExecutionPolicy Bypass -File app/instalar-atalho.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.9",
  "devDependencies": {
    "shadcn": "^4.22.1"
  }
}
